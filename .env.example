########################################
# IT SUPPORT - Variables d'environnement
# Copiez ce fichier en ".env" puis renseignez vos propres valeurs.
# Ne JAMAIS committer le fichier ".env" réel.
########################################

# --- Base de données PostgreSQL ---
POSTGRES_USER=itsupport
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=itsupport_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://itsupport:change_me_in_production@db:5432/itsupport_db

# --- Sécurité / JWT ---
# Obligatoire : générez une valeur aléatoire forte avant tout démarrage, par
# exemple avec `openssl rand -hex 32`. Il n'y a plus de valeur par défaut :
# le backend refuse de démarrer si SECRET_KEY est absente.
SECRET_KEY=change_this_super_secret_key_before_deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Backend FastAPI ---
BACKEND_PORT=8000
# Avec Nginx en reverse proxy (voir nginx/nginx.conf), le navigateur parle
# uniquement à http://localhost (port 80) : frontend et backend sont servis
# depuis la même origine, donc CORS ne s'applique jamais réellement dans ce
# flux (le proxy entre Nginx et le backend n'est jamais soumis à CORS,
# c'est une règle appliquée par le navigateur, pas par le serveur). Cette
# variable reste utile telle quelle si un jour le frontend est de nouveau
# servi depuis une origine différente (ex. accès direct à :3000 en dev, ou
# un futur déploiement où frontend et backend ne partagent plus un domaine).
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000
# HTTP simple pour l'instant (pas encore de certificat TLS devant Nginx) :
# ENVIRONMENT=development garde les cookies d'authentification sans l'attribut
# Secure, faute de quoi un navigateur les refuse silencieusement sur du HTTP
# non chiffré (voir _cookie_kwargs dans app/routers/auth.py). Le jour où un
# certificat est ajouté à Nginx, passer à ENVIRONMENT=production suffit —
# aucune autre modification n'est nécessaire.
ENVIRONMENT=development
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=15

# Exécute automatiquement `python -m app.seed` (comptes de démonstration,
# dont l'administrateur ci-dessous) au démarrage du conteneur backend.
# ⚠️ DOIT être à "false" dès que ENVIRONMENT=production — le backend refuse
# de toute façon de démarrer en production si cette valeur reste à "true"
# (voir app/config.py, _validate_production_secrets).
SEED_ON_STARTUP=true

# --- Frontend Next.js ---
FRONTEND_PORT=3000
# Chemin relatif : le navigateur appelle /api/... sur sa propre origine
# (http://localhost, via Nginx), qui route ensuite vers le backend — jamais
# "http://backend:8000" (nom résolu uniquement à l'intérieur du réseau
# Docker, injoignable depuis le navigateur) ni un port direct.
NEXT_PUBLIC_API_URL=/api

# --- Comptes de démonstration créés par le seed (développement uniquement) ---
# Un mot de passe par palier de rôle, partagé par tous les comptes de ce rôle.
# Choisissez vos propres valeurs ci-dessous (ne réutilisez pas les placeholders).
# En production : SEED_ON_STARTUP=false empêche leur création automatique.
# Si une de ces variables est absente, app/seed.py génère un mot de passe
# aléatoire à la place ; il n'est jamais journalisé (ni affiché en logs) et il
# n'y a plus aucun mot de passe codé en dur dans le code source.
SEED_ADMIN_EMAIL=admin@itsupport.example
SEED_ADMIN_PASSWORD=change_me
SEED_MANAGER_PASSWORD=change_me
SEED_TECHNICIAN_PASSWORD=change_me
SEED_USER_PASSWORD=change_me
