########################################
# IT SUPPORT - Variables d'environnement
# Copiez ce fichier en ".env" puis renseignez vos propres valeurs.
# Ne JAMAIS committer le fichier ".env" réel.
########################################

# --- Base de données PostgreSQL ---
POSTGRES_USER=itsupport
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=itsupport_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://itsupport:change_me_in_production@db:5432/itsupport_db

# --- Sécurité / JWT ---
# Générez une valeur aléatoire forte, par exemple : openssl rand -hex 32
SECRET_KEY=change_this_super_secret_key_before_deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Backend FastAPI ---
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=15

# --- Frontend Next.js ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Compte administrateur créé par le seed ---
SEED_ADMIN_EMAIL=admin@itsupport.example
SEED_ADMIN_PASSWORD=Admin123!
