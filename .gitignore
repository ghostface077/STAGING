# Environnement
.env
.env.production

# Sauvegardes PostgreSQL locales (voir docs/sauvegarde-restauration.md)
backups/

# Override Docker Compose local (republie le port PostgreSQL pour le dev — jamais en prod)
docker-compose.override.yml

# Backend Python
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/venv/
backend/.pytest_cache/
backend/uploads/*
!backend/uploads/.gitkeep
backend/*.db

# Frontend Node.js / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local

# Logs et sorties d'outils (jamais du code source)
*.log
backend/_*.log
frontend/_*.log

# Éditeurs / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
